#!/usr/bin/env bash

# Change working directory to user's home directory
cd "${HOME}"

# --- Base environment pre-EESSI ---
export TMPDIR=/tmp
export XDG_RUNTIME_DIR=/tmp/runtime-$(id -u)
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

export GDK_PIXBUF_MODULE_FILE=/usr/lib64/gdk-pixbuf-2.0/2.10.0/loaders.cache
export GSETTINGS_SCHEMA_DIR=/usr/share/glib-2.0/schemas
export XDG_DATA_DIRS=/usr/local/share:/usr/share

eval $(env TMPDIR=/tmp XDG_RUNTIME_DIR=/tmp/runtime-$(id -u) /usr/bin/dbus-launch --sh-syntax)

# --- Load EESSI ---
source /cvmfs/software.eessi.io/versions/2025.06/init/bash

# Load Modules
module load <%= context.selected_modules %>

# List Modules
echo "[INFO: MODULE LIST]"
module list

# Ensure that the user's configured login shell is used
export SHELL="$(getent passwd $USER | cut -d: -f7)"

# Start up desktop
echo "Launching desktop '<%= context.desktop %>'..."
source "<%= session.staged_root.join("desktops", "#{context.desktop}.sh") %>"
echo "Desktop '<%= context.desktop %>' ended..."

